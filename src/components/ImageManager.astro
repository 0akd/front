---
---
<div class="image-manager">
  <h2>Image Gallery Manager</h2>
  <form id="image-form" class="upload-section">
    <textarea id="base64-input" placeholder="Paste your base64 string here..." rows="5" required></textarea>
    <!-- ADDED: Position Input for New Uploads -->
    <input type="number" id="position-input" placeholder="Position (Default: 0)" value="0" style="padding: 0.5rem;" required />
    <button type="submit" id="upload-btn">Save Image</button>
  </form>
  <div id="image-gallery" class="gallery"></div>
</div>

<style>
  .image-manager { font-family: system-ui, sans-serif; }
  .upload-section { margin-bottom: 2rem; display: flex; flex-direction: column; gap: 1rem; max-width: 500px; }
  textarea { padding: 0.5rem; border: 1px solid #ccc; border-radius: 4px; font-family: monospace; resize: vertical; }
  .gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1rem; }
  button { cursor: pointer; padding: 0.75rem 1rem; background: #007bff; color: white; border: none; border-radius: 4px; font-weight: bold; }
  button:disabled { background: #999; }
</style>

<script>
  
  const API_URL = `${import.meta.env.PUBLIC_API_URL}/api/images`;
  const form = document.getElementById('image-form') as HTMLFormElement;
  const base64Input = document.getElementById('base64-input') as HTMLTextAreaElement;
  const positionInput = document.getElementById('position-input') as HTMLInputElement;
  const gallery = document.getElementById('image-gallery') as HTMLDivElement;
  const uploadBtn = document.getElementById('upload-btn') as HTMLButtonElement;

  const loadImages = async () => {
    try {
      const res = await fetch(API_URL);
      const metadata = await res.json();
      if (metadata.length === 0) { gallery.innerHTML = '<p>No images.</p>'; return; }
      gallery.innerHTML = '';
      for (const item of metadata) {
        const fullRes = await fetch(`${API_URL}/${item.id}`);
        const fullImage = await fullRes.json();
        const card = document.createElement('div');

        card.setAttribute('style', [
          'border: 1px solid #ddd',
          'border-radius: 8px',
          'overflow: hidden',
          'display: flex',
          'flex-direction: column',
          'background: #fff',
        ].join('; '));

        card.innerHTML = `
          <div style="width: 100%; height: 150px; overflow: hidden; flex-shrink: 0; background: #f5f5f5;">
            <img
              src="${fullImage.base64_data}"
              alt="Image ${fullImage.id}"
              style="width:100%; height:100%; object-fit:cover; display:block;"
              onerror="this.style.display='none'"
            />
          </div>
          <div style="padding: 0.5rem; display:flex; flex-direction:column; gap:0.4rem; flex:1;">
            <p style="font-size:0.75rem; color:#666; margin:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
              ${fullImage.filename}
            </p>
            
            <!-- ADDED: Position Edit Section -->
            <div style="display: flex; gap: 0.5rem; align-items: center; margin-top: 0.5rem;">
              <label style="font-size: 0.8rem;">Pos:</label>
              <input type="number" class="pos-input" data-id="${fullImage.id}" value="${fullImage.position || 0}" style="width: 60px; padding: 0.2rem;" />
              <button class="update-pos-btn" data-id="${fullImage.id}" style="padding: 0.2rem 0.5rem; background: #28a745; color: #fff; border: none; border-radius: 4px; font-size: 0.8rem; cursor: pointer;">Save</button>
            </div>

            <button class="delete-btn" data-id="${fullImage.id}" style="width:100%; padding:0.4rem; background:#dc3545; color:#fff; border:none; border-radius:4px; cursor:pointer; margin-top:auto;">Delete</button>
          </div>
        `;
        gallery.appendChild(card);
      }

      // Attach Delete Listeners
      document.querySelectorAll('.delete-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const id = (e.target as HTMLButtonElement).getAttribute('data-id');
          if (id) deleteImage(id);
        });
      });

      // ADDED: Attach Update Position Listeners
      document.querySelectorAll('.update-pos-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const id = (e.target as HTMLButtonElement).getAttribute('data-id');
          const input = document.querySelector(`.pos-input[data-id="${id}"]`) as HTMLInputElement;
          if (id && input) updatePosition(id, parseInt(input.value, 10));
        });
      });

    } catch {
      gallery.innerHTML = '<p>Error loading.</p>';
    }
  };

  // ADDED: Update Position Function
  const updatePosition = async (id: string, position: number) => {
    try {
      await fetch(`${API_URL}/${id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ position }),
      });
      await loadImages();
    } catch {
      alert('Failed to update position');
    }
  };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const base64_data = base64Input.value.trim();
    const position = parseInt(positionInput.value, 10) || 0; // Capture position
    if (!base64_data) return;
    
    uploadBtn.textContent = 'Saving...';
    uploadBtn.disabled = true;
    try {
      await fetch(API_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ base64_data, position }), // Send position
      });
      form.reset();
      positionInput.value = '0'; // Reset position default
      await loadImages();
    } catch {
      alert('Upload failed!');
    } finally {
      uploadBtn.textContent = 'Save Image';
      uploadBtn.disabled = false;
    }
  });

  const deleteImage = async (id: string) => {
    if (!confirm('Delete?')) return;
    try {
      await fetch(`${API_URL}/${id}`, { method: 'DELETE' });
      await loadImages();
    } catch {
      alert('Failed to delete');
    }
  };

  loadImages();
</script>