---
// Set your Hono backend URL (use env variable in production)
const API_URL = import.meta.env.PUBLIC_API_URL ?? 'http://127.0.0.1:8787';
// Fetch cards directly during Astro build/SSR
const res = await fetch(`${API_URL}/api/blog/cards`);
const { cards, error } = await res.json();
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=EB+Garamond:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet" />

<div class="vintage-wrap">
  {error ? (
    <p class="error">Error loading blogs: {error}</p>
  ) : (
    <div class="outer-frame">

      <div class="border-ornament"></div>

      <!-- Corner ornaments -->
      <div class="corner corner-tl" aria-hidden="true">
        <svg viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M2 2 L10 2 L10 4 L4 4 L4 10 L2 10 Z" fill="#6b4f2e"/>
          <circle cx="11" cy="11" r="2" fill="#8b6540"/>
          <path d="M12 2 L20 2 L20 10" stroke="#8b6540" stroke-width="0.5" fill="none"/>
        </svg>
      </div>
      <div class="corner corner-tr" aria-hidden="true">
        <svg viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M2 2 L10 2 L10 4 L4 4 L4 10 L2 10 Z" fill="#6b4f2e"/>
          <circle cx="11" cy="11" r="2" fill="#8b6540"/>
          <path d="M12 2 L20 2 L20 10" stroke="#8b6540" stroke-width="0.5" fill="none"/>
        </svg>
      </div>
      <div class="corner corner-bl" aria-hidden="true">
        <svg viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M2 2 L10 2 L10 4 L4 4 L4 10 L2 10 Z" fill="#6b4f2e"/>
          <circle cx="11" cy="11" r="2" fill="#8b6540"/>
          <path d="M12 2 L20 2 L20 10" stroke="#8b6540" stroke-width="0.5" fill="none"/>
        </svg>
      </div>
      <div class="corner corner-br" aria-hidden="true">
        <svg viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M2 2 L10 2 L10 4 L4 4 L4 10 L2 10 Z" fill="#6b4f2e"/>
          <circle cx="11" cy="11" r="2" fill="#8b6540"/>
          <path d="M12 2 L20 2 L20 10" stroke="#8b6540" stroke-width="0.5" fill="none"/>
        </svg>
      </div>

      <!-- Heading -->
      <div class="carousel-heading">read my blogs</div>

      <!-- Carousel -->
      <div class="carousel-box" id="blog-carousel">
        {cards.map((card: { title: string; description: string; slug: string }, index: number) => (
          <div class={`carousel-frame ${index === 0 ? 'active' : ''}`}>
            <a href={`/blog/${card.slug}`} class="frame-link">
              <h2 class="frame-title">{card.title}</h2>
              <p class="frame-desc">{card.description}</p>
            </a>
          </div>
        ))}
      </div>

      <!-- Dot navigation -->
      <div class="carousel-nav" id="carousel-dots">
        {cards.map((_: unknown, index: number) => (
          <button
            class={`carousel-dot ${index === 0 ? 'active' : ''}`}
            data-index={index}
            aria-label={`Slide ${index + 1}`}
          />
        ))}
      </div>

    </div>
  )}
</div>

<style>
  .vintage-wrap {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 2.5rem 1rem;
    background: #c8b89a;
    border-radius: 4px;
    position: relative;
  }

  .vintage-wrap::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 4px;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 28px,
      rgba(101, 79, 54, 0.06) 28px,
      rgba(101, 79, 54, 0.06) 29px
    );
    pointer-events: none;
  }

  .outer-frame {
    position: relative;
    width: 100%;
    max-width: 440px;
  }

  /* Double-rule border */
  .border-ornament {
    position: absolute;
    inset: -10px;
    border: 2px solid #6b4f2e;
    border-radius: 2px;
    z-index: 2;
    pointer-events: none;
  }
  .border-ornament::before {
    content: '';
    position: absolute;
    inset: 5px;
    border: 1px solid #8b6540;
    border-radius: 1px;
  }

  /* Corner ornaments */
  .corner {
    position: absolute;
    width: 22px;
    height: 22px;
    z-index: 3;
    pointer-events: none;
  }
  .corner svg {
    width: 22px;
    height: 22px;
  }
  .corner-tl { top: -16px; left: -16px; }
  .corner-tr { top: -16px; right: -16px; transform: rotate(90deg); }
  .corner-bl { bottom: -16px; left: -16px; transform: rotate(-90deg); }
  .corner-br { bottom: -16px; right: -16px; transform: rotate(180deg); }

  /* Main card */
  .carousel-box {
    position: relative;
    background: #f0e6cf;
    border: 1px solid #b89a6e;
    min-height: 200px;
    overflow: hidden;
    box-shadow:
      inset 0 2px 8px rgba(80, 50, 20, 0.12),
      0 4px 16px rgba(60, 40, 20, 0.3);
  }

  .carousel-box::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 10% 20%, rgba(180, 130, 70, 0.12) 0%, transparent 60%),
      radial-gradient(ellipse at 90% 80%, rgba(140, 100, 50, 0.10) 0%, transparent 60%);
    pointer-events: none;
    z-index: 1;
  }

  /* Frames */
  .carousel-frame {
    position: absolute;
    inset: 0;
    padding: 1.25rem 1.5rem;
    opacity: 0;
    transition: opacity 0.7s ease-in-out;
    pointer-events: none;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }
  .carousel-frame.active {
    opacity: 1;
    pointer-events: auto;
    position: relative;
    inset: unset;
  }

  .frame-link {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    height: 100%;
    justify-content: flex-start;
  }

  .carousel-heading {
    text-align: left;
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1rem;
    font-weight: 400;
    color: #3d2b1f;
    letter-spacing: 0.12em;
    border: 1px solid #8b6540;
    width: 100%;
    padding: 0.45rem 0.75rem;
    margin-bottom: 0.75rem;
    background: #e8d9b8;
    box-sizing: border-box;
    display: block;
  }

  .frame-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.2rem;
    font-weight: 600;
    color: #3d2b1f;
    margin: 0 0 0.6rem 0;
    line-height: 1.3;
    letter-spacing: 0.01em;
  }

  .frame-desc {
    font-family: 'EB Garamond', Georgia, serif;
    font-size: 0.97rem;
    color: #6b4f2e;
    margin: 0;
    line-height: 1.55;
    font-style: italic;
  }

  /* Dot nav */
  .carousel-nav {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin-top: 0.75rem;
    position: relative;
    z-index: 4;
  }

  .carousel-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #b89a6e;
    transition: background 0.3s, transform 0.3s;
    cursor: pointer;
    border: none;
    padding: 0;
  }
  .carousel-dot.active {
    background: #6b4f2e;
    transform: scale(1.3);
  }

  .error {
    color: #8b2020;
    font-family: 'EB Garamond', Georgia, serif;
  }
</style>

<script>
  function initCarousel() {
    const frames = document.querySelectorAll('.carousel-frame');
    const dots = document.querySelectorAll('.carousel-dot');
    if (frames.length <= 1) return;

    let current = 0;
    let timer: ReturnType<typeof setInterval>;

    function goTo(i: number) {
      frames[current].classList.remove('active');
      dots[current]?.classList.remove('active');
      current = (i + frames.length) % frames.length;
      frames[current].classList.add('active');
      dots[current]?.classList.add('active');
    }

    function startTimer() {
      clearInterval(timer);
      timer = setInterval(() => goTo(current + 1), 4000);
    }

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        goTo(parseInt((dot as HTMLElement).dataset.index ?? '0'));
        startTimer();x
      });
    });

    startTimer();
  }

  document.addEventListener('astro:page-load', initCarousel);
  document.addEventListener('DOMContentLoaded', initCarousel);
</script>