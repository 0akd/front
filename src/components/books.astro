---
// src/components/books.astro
import PDFViewer from './pdfviewer.astro/';   // ← ADD THIS LINE

export const prerender = false;

const API_BASE = import.meta.env.PUBLIC_API_URL ?? 'http://127.0.0.1:8787';

let books = [];
try {
  const res = await fetch(`${API_BASE}/api/books`, {
    credentials: 'include',
    signal: AbortSignal.timeout(5000)
  });
  if (!res.ok) throw new Error(`API returned ${res.status}`);
  books = await res.json();
} catch (error) {
  console.warn('[books.astro] Could not fetch books during build:', error.message);
  books = [];
}
---

<div class="library-wrapper">
  <div class="header">
    <h1>📚 My Reading Library</h1>
    <p class="subtitle">Continue where you left off • Click any book to open in custom viewer</p>
  </div>

  <!-- Books Grid -->
  <div class="books-grid">
    {books.length === 0 ? (
      <div class="empty-state">
        <div class="empty-icon">📖</div>
        <h3>No books yet</h3>
        <p>Ask an admin to add some books for you!</p>
      </div>
    ) : (
      books.map((book: any) => (
        <div
          class="book-card"
          onclick={`openBookViewer(${JSON.stringify(book)})`}
        >
          <div class="book-cover">
            <div class="cover-placeholder">📕</div>
            {book.current_page > 1 && (
              <div class="progress-badge">Page {book.current_page}</div>
            )}
          </div>
          <div class="book-info">
            <h3>{book.name}</h3>
            <div class="meta">
              <span>Added {new Date(book.created_at).toLocaleDateString()}</span>
              {book.current_page > 1 && (
                <span class="last-read">• Last read: Page {book.current_page}</span>
              )}
            </div>
            <button
              class="read-btn"
              onclick={`event.stopImmediatePropagation(); openBookViewer(${JSON.stringify(book)})`}
            >
              {book.current_page > 1 ? '📖 Continue Reading' : '📖 Start Reading'}
            </button>
          </div>
        </div>
      ))
    )}
  </div>
</div>

<!-- PDF Viewer Component -->
<PDFViewer apiBase={API_BASE} />

<style>
  .library-wrapper {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
  }
  .header {
    text-align: center;
    margin-bottom: 3rem;
  }
  .header h1 {
    font-size: 2.75rem;
    color: #0f172a;
    margin: 0 0 0.5rem;
  }
  .subtitle {
    color: #64748b;
    font-size: 1.1rem;
    margin: 0;
  }
  .books-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.75rem;
  }
  .book-card {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.05);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
    display: flex;
    flex-direction: column;
  }
  .book-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
  }
  .book-cover {
    height: 180px;
    background: linear-gradient(135deg, #1e2937 0%, #334155 100%);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 4rem;
    color: #64748b;
  }
  .progress-badge {
    position: absolute;
    top: 12px;
    right: 12px;
    background: #22c55e;
    color: white;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 2px 10px;
    border-radius: 9999px;
    box-shadow: 0 2px 4px rgb(0 0 0 / 0.2);
  }
  .book-info {
    padding: 1.5rem;
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .book-info h3 {
    margin: 0 0 0.75rem;
    font-size: 1.25rem;
    color: #0f172a;
    line-height: 1.3;
  }
  .meta {
    color: #64748b;
    font-size: 0.875rem;
    margin-bottom: 1.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }
  .last-read {
    color: #15803d;
    font-weight: 600;
  }
  .read-btn {
    margin-top: auto;
    background: #3b82f6;
    color: white;
    border: none;
    padding: 12px 24px;
    border-radius: 12px;
    font-weight: 700;
    font-size: 0.95rem;
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }
  .read-btn:hover {
    background: #2563eb;
    transform: scale(1.02);
  }
  .empty-state {
    grid-column: 1 / -1;
    text-align: center;
    padding: 4rem 2rem;
    background: #f8fafc;
    border-radius: 20px;
  }
  .empty-icon {
    font-size: 4rem;
    margin-bottom: 1rem;
  }
</style>

<script>
  console.log('%c[Library] Page ready — PDF viewer loaded from component', 'color:#64748b');
</script>