---
export const prerender = true;

const API_BASE =  import.meta.env.PUBLIC_API_URL ?? 'http://127.0.0.1:8787';

let treeData: any[] = [];

try {
  const res = await fetch(`${API_BASE}/vault`);
  if (res.ok) {
    const data = await res.json();
    const files: any[] = data.files || [];

    // Build recursive tree from flat path list
    const root: any[] = [];
    const map: Record<string, any> = {};

    for (const file of files) {
      const parts: string[] = file.path.split('/');
      let currentLevel = root;
      let currentPath = '';

      for (let i = 0; i < parts.length; i++) {
        const part = parts[i];
        currentPath = currentPath ? `${currentPath}/${part}` : part;
        const isFile = i === parts.length - 1;

        if (!map[currentPath]) {
          const node: any = {
            name: part,
            path: currentPath,
            type: isFile ? 'blob' : 'tree',
            size: isFile ? file.size : undefined,
            children: [],
          };
          map[currentPath] = node;
          currentLevel.push(node);
        }
        currentLevel = map[currentPath].children;
      }
    }

    treeData = root;
  }
} catch (e) {
  console.error('Vault fetch error:', e);
}

function getIcon(name: string): string {
  const ext = name.split('.').pop()?.toLowerCase() || '';
  const icons: Record<string, string> = {
    pdf: '📄', png: '🖼️', jpg: '🖼️', jpeg: '🖼️',
    gif: '🖼️', svg: '🖼️', mp4: '🎬', mp3: '🎵',
    zip: '📦', txt: '📝', md: '📝', ts: '💻',
    js: '💻', json: '🔧', html: '🌐', css: '🎨',
  };
  return icons[ext] || '📄';
}

function formatSize(bytes?: number): string {
  if (!bytes) return '';
  if (bytes < 1024) return `${bytes} B`;
  if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
  return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
}

// Recursive render function
function renderNode(node: any, apiBase: string): string {
  if (node.type === 'tree') {
    const children = node.children.map((c: any) => renderNode(c, apiBase)).join('');
    return `
      <li>
        <details open>
          <summary class="tree-row">
            <svg class="chevron" width="12" height="12" viewBox="0 0 16 16" fill="currentColor">
              <path d="M6.22 3.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L9.94 8 6.22 4.28a.75.75 0 0 1 0-1.06Z"/>
            </svg>
            <svg class="folder-icon" width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
              <path d="M1.75 1A1.75 1.75 0 0 0 0 2.75v10.5C0 14.216.784 15 1.75 15h12.5A1.75 1.75 0 0 0 16 13.25v-8.5A1.75 1.75 0 0 0 14.25 3H7.5a.25.25 0 0 1-.2-.1l-.9-1.2C6.07 1.26 5.55 1 5 1H1.75Z"/>
            </svg>
            <span class="item-name">${node.name}</span>
          </summary>
          <ul class="tree-nested">${children}</ul>
        </details>
      </li>`;
  } else {
    return `
      <li>
        <div class="tree-row">
          <span style="flex-shrink:0;font-size:0.9rem">${getIcon(node.name)}</span>
          <a class="item-name" href="${apiBase}/vault/raw/${node.path}" target="_blank" rel="noopener noreferrer">${node.name}</a>
          <span class="item-size">${formatSize(node.size)}</span>
        </div>
      </li>`;
  }
}

const renderedTree = treeData.map(n => renderNode(n, API_BASE)).join('');
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Vault — 0akd/new</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { background: #0d1117; color: #c9d1d9; font-family: ui-sans-serif, system-ui, -apple-system, sans-serif; min-height: 100vh; padding: 2rem 1rem; }
    .page { max-width: 860px; margin: 0 auto; }
    .topbar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 0.75rem; }
    .topbar-left { display: flex; align-items: center; gap: 0.6rem; color: #58a6ff; }
    .repo-name { font-size: 1.1rem; font-weight: 600; color: #58a6ff; }
    .repo-sep { color: #8b949e; }
    .back-link { color: #8b949e; text-decoration: none; font-size: 0.85rem; transition: color 0.2s; }
    .back-link:hover { color: #c9d1d9; }
    .search-wrap { position: relative; margin-bottom: 1rem; }
    .search-wrap svg { position: absolute; left: 10px; top: 50%; transform: translateY(-50%); color: #8b949e; pointer-events: none; }
    #vault-search { width: 100%; padding: 0.55rem 1rem 0.55rem 2.2rem; background: #161b22; border: 1px solid #30363d; border-radius: 6px; color: #c9d1d9; font-size: 0.9rem; outline: none; transition: border-color 0.2s; }
    #vault-search:focus { border-color: #58a6ff; }
    .tree-card { background: #161b22; border: 1px solid #30363d; border-radius: 8px; overflow: hidden; }
    .tree-card-header { display: flex; align-items: center; justify-content: space-between; padding: 0.65rem 1rem; background: #1c2128; border-bottom: 1px solid #30363d; font-size: 0.82rem; color: #8b949e; }
    ul { list-style: none; }
    .tree-row { display: flex; align-items: center; gap: 0.5rem; padding: 0.42rem 1rem; border-bottom: 1px solid #21262d; transition: background 0.15s; min-width: 0; cursor: pointer; }
    .tree-row:hover { background: #1c2128; }
    .tree-nested { padding-left: 1.4rem; border-left: 1px solid #21262d; margin-left: 1.5rem; }
    details > summary { list-style: none; cursor: pointer; }
    details > summary::-webkit-details-marker { display: none; }
    .chevron { transition: transform 0.2s; flex-shrink: 0; color: #8b949e; }
    details[open] > summary .chevron { transform: rotate(90deg); }
    .folder-icon { color: #79c0ff; flex-shrink: 0; }
    .item-name { flex: 1; font-size: 0.88rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: #c9d1d9; }
    a.item-name { text-decoration: none; color: #c9d1d9; transition: color 0.15s; }
    a.item-name:hover { color: #58a6ff; text-decoration: underline; }
    .item-size { font-size: 0.78rem; color: #8b949e; white-space: nowrap; margin-left: auto; padding-left: 1rem; flex-shrink: 0; }
    .empty { padding: 2rem; text-align: center; color: #8b949e; font-size: 0.9rem; }
  </style>
</head>
<body>
  <div class="page">
    <div class="topbar">
      <div class="topbar-left">
        <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor">
          <path d="M2 2.5A2.5 2.5 0 0 1 4.5 0h8.75a.75.75 0 0 1 .75.75v12.5a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 1 0-1.5h1.75v-2h-8a1 1 0 0 0-.714 1.7.75.75 0 1 1-1.072 1.05A2.495 2.495 0 0 1 2 11.5Zm10.5-1v-1h-8a1 1 0 0 0-1 1v6.708A2.486 2.486 0 0 1 4.5 9h8ZM5 12.25a.25.25 0 0 1 .25-.25h3.5a.25.25 0 0 1 .25.25v3.25a.25.25 0 0 1-.4.2l-1.45-1.087a.249.249 0 0 0-.3 0L5.4 15.7a.25.25 0 0 1-.4-.2Z"/>
        </svg>
        <span class="repo-sep">0akd</span>
        <span class="repo-sep">/</span>
        <span class="repo-name">new</span>
      </div>
      <a href="/" class="back-link">← Back to home</a>
    </div>

    <div class="search-wrap">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
        <path d="M10.68 11.74a6 6 0 0 1-7.922-8.982 6 6 0 0 1 8.982 7.922l3.04 3.04a.749.749 0 0 1-.326 1.275.749.749 0 0 1-.734-.215ZM11.5 7a4.499 4.499 0 1 0-8.997 0A4.499 4.499 0 0 0 11.5 7Z"/>
      </svg>
      <input id="vault-search" type="text" placeholder="Search files…" autocomplete="off" />
    </div>

    <div class="tree-card">
      <div class="tree-card-header">
        <span>Name</span>
        <span>Size</span>
      </div>
      <ul id="tree-root">
        {treeData.length === 0
          ? <li class="empty">No files found or backend unreachable.</li>
          : <Fragment set:html={renderedTree} />
        }
      </ul>
    </div>
  </div>

  <script is:inline>
    const search = document.getElementById('vault-search');
    search.addEventListener('input', () => {
      const q = search.value.toLowerCase().trim();
      if (!q) {
        document.querySelectorAll('#tree-root li').forEach(li => li.style.display = '');
        document.querySelectorAll('details').forEach(d => d.open = true);
        return;
      }
      // Show only matching files, reveal their parent folders
      document.querySelectorAll('#tree-root li').forEach(li => {
        const text = li.querySelector('a')?.textContent?.toLowerCase() || '';
        li.style.display = text.includes(q) ? '' : 'none';
      });
      document.querySelectorAll('details').forEach(d => d.open = true);
    });
  </script>
</body>
</html>