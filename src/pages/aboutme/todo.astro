---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="My ToDo App">
  <main class="container" id="protected-content" style="display: none;">
    <div class="header">
      <h1>My ToDos</h1>
      <button id="logout-btn" class="btn-danger">Logout</button>
    </div>

    <div class="input-group">
      <input type="text" id="new-todo" placeholder="What needs to be done?" />
      <input type="number" id="todo-position" min="1" title="Position" style="width: 60px;" />
      <span id="total-positions" style="align-self: center;"></span>
      <button id="add-btn">Add</button>
    </div>

    <ul id="todo-list"></ul>
  </main>
</Layout>

<script>
  const BASE_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:8787';
  const API_URL = `${BASE_URL}/todos`;
  const AUTH_URL = `${BASE_URL}/api/auth/logout`;
  
  const appContainer = document.getElementById('protected-content');
  const todoList = document.getElementById('todo-list');
  const newTodoInput = document.getElementById('new-todo') as HTMLInputElement;
  const positionInput = document.getElementById('todo-position') as HTMLInputElement;
  const totalPositionsSpan = document.getElementById('total-positions');
  const addBtn = document.getElementById('add-btn') as HTMLButtonElement;
  const logoutBtn = document.getElementById('logout-btn');

  let totalTodos = 0;

  async function authFetch(url: string, options: RequestInit = {}) {
    const token = localStorage.getItem('auth_token');
    if (!token) {
      window.location.href = '/';
      throw new Error('Authentication token missing');
    }

    const headers = {
      'Content-Type': 'application/json',
      'Authorization': `Bearer ${token}`,
      ...(options.headers || {})
    };

    const response = await fetch(url, { ...options, headers });
    
    if (response.status === 401 || response.status === 403) {
      localStorage.removeItem('auth_token');
      window.location.href = '/';
      throw new Error('Session expired');
    }
    return response;
  }

  async function loadTodos() {
    try {
      const res = await authFetch(API_URL);
      const todos = await res.json();
      renderTodos(todos);
    } catch (error) {
      console.error("Fetch failed:", error);
    }
  }

  async function addTodo() {
    const title = newTodoInput.value.trim();
    const position = parseInt(positionInput.value) || (totalTodos + 1);
    if (!title) return;

    newTodoInput.disabled = true;
    addBtn.disabled = true;

    try {
      await authFetch(API_URL, {
        method: 'POST',
        body: JSON.stringify({ title, position })
      });
      newTodoInput.value = '';
      await loadTodos();
    } finally {
      newTodoInput.disabled = false;
      addBtn.disabled = false;
      newTodoInput.focus();
    }
  }

  // UPDATED: Now supports updating title and position alongside completed
  async function updateTodo(id: number, updates: { completed?: boolean, title?: string, position?: number }) {
    await authFetch(`${API_URL}/${id}`, {
      method: 'PUT',
      body: JSON.stringify(updates)
    });
    loadTodos();
  }

async function deleteTodo(id: number) {
    if (!window.confirm("Are you sure you want to delete this to-do?")) return;
    
    await authFetch(`${API_URL}/${id}`, { method: 'DELETE' });
    loadTodos();
  }

  function renderTodos(todos: any[]) {
    if (!todoList) return;
    todoList.innerHTML = '';
    
    totalTodos = todos.length;
    const nextPos = totalTodos + 1;
    if (positionInput && totalPositionsSpan) {
      positionInput.max = nextPos.toString();
      positionInput.value = nextPos.toString();
      totalPositionsSpan.textContent = `of ${nextPos}`;
    }
    
    todos.forEach((todo) => {
      const li = document.createElement('li');
      li.className = 'todo-item';

      // --- VIEW MODE ELEMENTS ---
      const viewDiv = document.createElement('div');
      viewDiv.className = 'view-mode';

      const checkbox = document.createElement('input');
      checkbox.type = 'checkbox';
      checkbox.checked = todo.completed;
      checkbox.onchange = () => updateTodo(todo.id, { completed: checkbox.checked });

      const span = document.createElement('span');
      span.textContent = `[${todo.position}] ${todo.title}`;
      span.style.textDecoration = todo.completed ? 'line-through' : 'none';

      const btnGroup = document.createElement('div');
      btnGroup.className = 'btn-group';

      const editBtn = document.createElement('button');
      editBtn.textContent = 'Edit';
      editBtn.className = 'edit-btn';

      const deleteBtn = document.createElement('button');
      deleteBtn.textContent = 'Delete';
      deleteBtn.className = 'btn-danger';
      deleteBtn.onclick = () => deleteTodo(todo.id);

      btnGroup.appendChild(editBtn);
      btnGroup.appendChild(deleteBtn);

      viewDiv.appendChild(checkbox);
      viewDiv.appendChild(span);
      viewDiv.appendChild(btnGroup);

      // --- EDIT MODE ELEMENTS ---
      const editDiv = document.createElement('div');
      editDiv.className = 'edit-mode';
      editDiv.style.display = 'none';

      const editPosInput = document.createElement('input');
      editPosInput.type = 'number';
      editPosInput.value = todo.position;
      editPosInput.min = '1';
      editPosInput.style.width = '60px';

      const editTitleInput = document.createElement('input');
      editTitleInput.type = 'text';
      editTitleInput.value = todo.title;

      const saveBtn = document.createElement('button');
      saveBtn.textContent = 'Save';
      saveBtn.className = 'save-btn';

      const cancelBtn = document.createElement('button');
      cancelBtn.textContent = 'Cancel';
      cancelBtn.className = 'cancel-btn';

      editDiv.appendChild(editPosInput);
      editDiv.appendChild(editTitleInput);
      editDiv.appendChild(saveBtn);
      editDiv.appendChild(cancelBtn);

      // --- TOGGLE LOGIC ---
      editBtn.onclick = () => {
        viewDiv.style.display = 'none';
        editDiv.style.display = 'flex';
        editTitleInput.focus();
      };

      cancelBtn.onclick = () => {
        viewDiv.style.display = 'flex';
        editDiv.style.display = 'none';
      };

      saveBtn.onclick = () => {
        const newTitle = editTitleInput.value.trim();
        const newPos = parseInt(editPosInput.value);
        if (newTitle && (newTitle !== todo.title || newPos !== todo.position)) {
          updateTodo(todo.id, { title: newTitle, position: newPos });
        } else {
          cancelBtn.click();
        }
      };

      // Handle Enter key to save
      editTitleInput.onkeypress = (e) => {
        if (e.key === 'Enter') saveBtn.click();
      };

      li.appendChild(viewDiv);
      li.appendChild(editDiv);
      todoList.appendChild(li);
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    const token = localStorage.getItem('auth_token');
    if (!token) {
      window.location.href = '/';
      return;
    }
    if (appContainer) appContainer.style.display = 'block';
    loadTodos();
  });

  addBtn?.addEventListener('click', addTodo);
  newTodoInput?.addEventListener('keypress', (e) => {
    if (e.key === 'Enter') addTodo();
  });

  logoutBtn?.addEventListener('click', async () => {
    const token = localStorage.getItem('auth_token');
    localStorage.removeItem('auth_token');
    if (token) {
      fetch(AUTH_URL, { 
        method: 'POST', 
        headers: { 'Authorization': `Bearer ${token}` }
      }).catch(() => {}); 
    }
    window.location.href = '/';
  });
</script>
<style>
  .container { max-width: 600px; margin: 3rem auto; font-family: system-ui, sans-serif; }
  .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; }
  h1 { margin: 0; }
  .input-group { display: flex; gap: 0.5rem; margin-bottom: 1.5rem; }
  
  /* Use Variables */
  input[type="text"], input[type="number"] { 
    flex: 1; 
    padding: 0.5rem; 
    border: 1px solid var(--border-color); 
    border-radius: 4px; 
    background: var(--input-bg);
    color: var(--text-color);
  }
  
  button { 
    padding: 0.5rem 1rem; 
    cursor: pointer; 
    background: var(--btn-bg); 
    color: white; 
    border: none; 
    border-radius: 4px; 
    transition: opacity 0.2s; 
  }
  button:hover { opacity: 0.8; }
  button:disabled { opacity: 0.5; cursor: not-allowed; }
  
  .btn-danger { background: #dc3545; }
  .edit-btn { background: #007bff; }
  .save-btn { background: #28a745; }
  .cancel-btn { background: #6c757d; }
  
  ul { padding: 0; list-style: none; }
  
  /* Use Variables */
  .todo-item { padding: 0.5rem 0; border-bottom: 1px solid var(--item-border); }
  
  .view-mode, .edit-mode { display: flex; align-items: center; gap: 0.8rem; width: 100%; }
  .view-mode span { flex: 1; word-break: break-all; }
  .edit-mode input[type="text"] { flex: 1; }
  .btn-group { display: flex; gap: 0.3rem; }
  .btn-group button { font-size: 0.8rem; padding: 0.3rem 0.6rem; }
</style>