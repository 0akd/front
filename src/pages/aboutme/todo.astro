// ==================== CREATE DYNAMIC INPUT (with category selector) ====================
function createDynamicInput() {
const container = document.getElementById('add-task-container');
if (!container) return;
const inputWrapper = container.querySelector('.flex-1');
if (!inputWrapper) return;

const wrapper = document.createElement('div');
wrapper.className = 'flex-1 flex flex-col sm:flex-row gap-3 w-full';

newTodoInput = document.createElement('input');
newTodoInput.type = 'text';
newTodoInput.id = 'new-todo';
newTodoInput.className = 'flex-1 bg-white dark:bg-zinc-900 border-2 border-zinc-300 dark:border-white/40 text-[17px] text-zinc-900 dark:text-zinc-100 placeholder:text-zinc-400 dark:placeholder:text-zinc-500 focus:outline-none focus:border-violet-500 focus:ring-2 focus:ring-violet-500 px-4 py-3.5 rounded-2xl transition-all';
newTodoInput.placeholder = 'What needs to be done?';
newTodoInput.autocomplete = 'off';
newTodoInput.style.cssText = 'pointer-events: auto !important; user-select: text !important; caret-color: #a855f7;';

const catSelect = document.createElement('select');
catSelect.id = 'category-select';
catSelect.className = 'w-full sm:w-48 bg-white dark:bg-zinc-900 border-2 border-zinc-300 dark:border-white/40 text-sm rounded-2xl px-3 py-3.5 focus:outline-none focus:border-violet-500';

catSelect.innerHTML = `<option value="">No category</option>`;
function addCatOptions(cats, prefix = '') {
cats.forEach(cat => {
const opt = document.createElement('option');
opt.value = cat.id;
opt.textContent = `${prefix}${cat.name}`;
catSelect.appendChild(opt);
if (cat.children && cat.children.length > 0) addCatOptions(cat.children, prefix + '↳ ');
});
}
addCatOptions(categories);

newTodoInput.addEventListener('keydown', function(e) {
if (e.key === 'Enter') { e.preventDefault(); addTodo(); }
}, true);

wrapper.appendChild(newTodoInput);
wrapper.appendChild(catSelect);
inputWrapper.innerHTML = '';
inputWrapper.appendChild(wrapper);

newTodoInput.disabled = false;
newTodoInput.readOnly = false;
}

// ==================== INIT ====================
document.addEventListener('DOMContentLoaded', async () => {
if (!localStorage.getItem('auth_token')) { window.location.href = '/'; return; }

initThemeToggle();
await loadCategories();
await loadTodos();
createDynamicInput();

const addBtn = document.getElementById('add-btn');
if (addBtn && newTodoInput) addBtn.onclick = addTodo;

const resetBtn = document.getElementById('reset-btn');
const summaryBtn = document.getElementById('summary-btn');
const logoutBtn = document.getElementById('logout-btn');
const categoriesBtn = document.getElementById('categories-btn');

if (resetBtn) resetBtn.onclick = resetTodos;
if (summaryBtn) summaryBtn.onclick = fetchSummary;
if (logoutBtn) logoutBtn.onclick = () => { localStorage.removeItem('auth_token'); window.location.href = '/'; };
if (categoriesBtn) categoriesBtn.onclick = openCategoryModal;

const addRootBtn = document.getElementById('add-root-category');
if (addRootBtn) addRootBtn.onclick = async () => {
const name = prompt("New root category name:");
if (name) await createCategory(name);
};

const showUncategorized = document.getElementById('show-uncategorized');
if (showUncategorized) showUncategorized.onclick = () => {
selectedCategoryFilter = -1;
renderTodos();
renderCategoryTree();
};

// Modals
const modal = document.getElementById('summary-modal');
const closeModal = document.getElementById('close-modal');
if (closeModal && modal) closeModal.onclick = () => modal.style.display = 'none';
if (modal) modal.onclick = e => { if (e.target === modal) modal.style.display = 'none'; };

const catModal = document.getElementById('category-modal');
const closeCatModal = document.getElementById('close-category-modal');
if (closeCatModal && catModal) closeCatModal.onclick = () => catModal.style.display = 'none';

const createCatBtn = document.getElementById('create-category-btn');
const newCatInput = document.getElementById('new-category-name');
if (createCatBtn && newCatInput) {
createCatBtn.onclick = async () => {
if (newCatInput.value.trim()) {
await createCategory(newCatInput.value.trim());
newCatInput.value = '';
}
};
}

const copyBtn = document.getElementById('copy-summary');
if (copyBtn) copyBtn.onclick = () => {
const text = document.getElementById('summary-text')?.innerText || '';
navigator.clipboard.writeText(text).then(() => showToast("Summary copied"));
};

setTimeout(() => {
if (newTodoInput) newTodoInput.focus();
}, 800);
});
</script>
