---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="My ToDos • Modern">
<main class="min-h-screen bg-white text-zinc-900 dark:bg-zinc-950 dark:text-zinc-200 transition-colors duration-300 touch-manipulation">
<!-- Header -->
<nav class="sticky top-0 z-50 border-b border-zinc-200 dark:border-white/10 bg-white/80 dark:bg-zinc-950/80 backdrop-blur-xl">
<div class="mx-auto max-w-6xl px-4 sm:px-6 h-16 flex items-center justify-between">
<div class="flex items-center gap-3">

</div>
<!-- Navbar buttons -->
<div class="flex items-center gap-1 sm:gap-2">
<button id="theme-toggle"
class="px-3 sm:px-4 py-2.5 rounded-2xl bg-zinc-100 dark:bg-white/10 active:bg-zinc-200 dark:active:bg-white/15 text-sm font-medium flex items-center gap-2 transition-all active:scale-[0.985]">
<span class="dark:hidden">🌙</span>
<span class="hidden dark:inline">☀️</span>
</button>
<button id="categories-btn"
class="px-3 sm:px-5 py-2.5 rounded-2xl bg-zinc-100 dark:bg-white/10 active:bg-zinc-200 dark:active:bg-white/15 text-sm font-medium flex items-center gap-2 transition-all active:scale-[0.985]">
<span>📁</span>
<span class="hidden sm:inline">Categories</span>
</button>
<button id="summary-btn"
class="px-3 sm:px-5 py-2.5 rounded-2xl bg-zinc-100 dark:bg-white/10 active:bg-zinc-200 dark:active:bg-white/15 text-sm font-medium flex items-center gap-2 transition-all active:scale-[0.985]">
<span>✨</span>
<span class="hidden sm:inline">AI Summary</span>
</button>
<button id="reset-btn"
class="px-3 sm:px-5 py-2.5 rounded-2xl bg-zinc-100 dark:bg-white/10 active:bg-zinc-200 dark:active:bg-white/15 text-sm font-medium flex items-center gap-2 transition-all active:scale-[0.985]">
Reset
</button>
<button id="logout-btn"
class="px-3 sm:px-5 py-2.5 rounded-2xl bg-red-500/90 active:bg-red-600 text-sm font-medium text-white transition-all active:scale-[0.985]">
Logout
</button>
</div>
</div>
</nav>

<div class="mx-auto max-w-6xl px-4 sm:px-6 pt-8 pb-24 flex gap-8">
<!-- Category Sidebar -->
<aside class="w-64 hidden lg:block flex-shrink-0">
<div class="glass-card p-4 sticky top-20">
<div class="flex items-center justify-between mb-4">
<h3 class="font-semibold text-sm text-zinc-500 dark:text-zinc-400">CATEGORIES</h3>
<button id="add-root-category" class="text-xs px-2 py-1 rounded-lg bg-violet-500/10 text-violet-600 dark:text-violet-400 active:bg-violet-500/20">+ Root</button>
</div>
<div id="category-tree" class="space-y-1 text-sm"></div>
<div class="mt-4 pt-4 border-t border-zinc-200 dark:border-white/10">
<button id="show-uncategorized" class="w-full text-left px-3 py-2 text-sm rounded-xl hover:bg-zinc-100 dark:hover:bg-white/5 flex items-center gap-2">
<span>📭</span> <span>Uncategorized</span>
</button>
</div>
</div>
</aside>

<!-- Main Content -->
<div class="flex-1 min-w-0">
<!-- Progress -->
<div class="mb-8 flex items-center justify-between">
<div class="flex items-center gap-3">
<div class="relative w-16 h-16 flex-shrink-0">
<svg class="w-16 h-16 -rotate-90" viewBox="0 0 100 100">
<circle cx="50" cy="50" r="42" fill="none" stroke="#e5e7eb" class="dark:stroke-zinc-800" stroke-width="8"/>
<circle id="progress-circle" cx="50" cy="50" r="42" fill="none"
stroke="#a855f7" stroke-width="8" stroke-linecap="round"
stroke-dasharray="263.89" stroke-dashoffset="263.89"/>
</svg>
<div class="absolute inset-0 flex items-center justify-center">
<span id="progress-text" class="text-2xl font-semibold tabular-nums">0</span>
</div>
</div>
<div>
<div class="text-sm text-zinc-500 dark:text-zinc-400">Overall progress</div>
<div id="progress-label" class="text-xl font-medium">0 of 0 completed</div>
</div>
</div>
<div id="total-positions" class="text-sm text-zinc-500 dark:text-zinc-400"></div>
</div>

<!-- Add Task -->
<div id="add-task-container" class="glass-card mb-8 p-2 flex flex-col sm:flex-row gap-3 items-center">
<div class="flex-1 flex flex-col sm:flex-row items-center gap-3 w-full" style="pointer-events: auto !important;">
<!-- Dynamic input injected by JS -->
</div>
<button id="add-btn"
class="w-full sm:w-auto px-8 py-3.5 rounded-2xl bg-gradient-to-r from-violet-500 to-fuchsia-500 text-white font-medium flex items-center justify-center gap-2 active:brightness-110 active:scale-[0.985] transition-all whitespace-nowrap disabled:opacity-60 disabled:cursor-not-allowed">
<span id="add-btn-text">Add Task</span>
<span class="text-lg">→</span>
</button>
</div>

<!-- Todo List -->
<div id="todo-list" class="space-y-3"></div>
</div>
</div>
</main>

<!-- Category Management Modal -->
<div id="category-modal" class="fixed inset-0 z-[110] hidden items-center justify-center bg-black/70 p-6">
<div class="glass-card w-full max-w-2xl rounded-3xl overflow-hidden max-h-[90vh] flex flex-col">
<div class="flex items-center justify-between border-b border-zinc-200 dark:border-white/10 px-6 py-4">
<div class="flex items-center gap-3">
<div class="text-2xl">📁</div>
<h2 class="font-semibold text-xl">Manage Categories</h2>
</div>
<button id="close-category-modal" class="text-3xl text-zinc-400 active:text-zinc-900 dark:active:text-white transition-colors px-2">×</button>
</div>
<div class="p-6 flex-1 overflow-auto">
<div class="mb-4 flex gap-2">
<input id="new-category-name" type="text" placeholder="New category name" class="flex-1 bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-white/10 rounded-2xl px-4 py-3 text-sm focus:outline-none focus:border-violet-500">
<button id="create-category-btn" class="px-6 py-3 bg-violet-600 text-white rounded-2xl text-sm font-medium active:scale-[0.985]">Create Root</button>
</div>
<div id="category-management-tree" class="space-y-2 text-sm"></div>
</div>
<div class="border-t border-zinc-200 dark:border-white/10 p-4 text-xs text-zinc-500 dark:text-zinc-400">
Tip: Drag to reorder or right-click for more options. Use cascade delete to remove entire branches.
</div>
</div>
</div>

<!-- Summary Modal (unchanged) -->
<div id="summary-modal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/70 p-6">
<div class="glass-card w-full max-w-lg rounded-3xl overflow-hidden">
<div class="flex items-center justify-between border-b border-zinc-200 dark:border-white/10 px-6 py-4">
<div class="flex items-center gap-3">
<div class="text-2xl">✨</div>
<h2 class="font-semibold text-xl">AI Summary</h2>
</div>
<button id="close-modal" class="text-3xl text-zinc-400 active:text-zinc-900 dark:active:text-white transition-colors px-2">×</button>
</div>
<div class="p-6">
<div id="summary-loading" class="hidden flex flex-col items-center justify-center py-8">
<div class="w-8 h-8 border-2 border-violet-500 border-t-transparent rounded-full animate-spin"></div>
<p class="mt-4 text-sm text-zinc-500 dark:text-zinc-400">Analyzing your tasks with AI...</p>
</div>
<div id="summary-text" class="prose prose-zinc dark:prose-invert text-zinc-700 dark:text-zinc-300 min-h-[120px]"></div>
<div class="mt-6 flex justify-end">
<button id="copy-summary" class="px-5 py-3 text-sm rounded-2xl border border-zinc-200 dark:border-white/20 active:bg-zinc-100 dark:active:bg-white/5 flex items-center gap-2">📋 Copy</button>
</div>
</div>
</div>
</div>

<div id="toast-container" class="fixed bottom-6 right-6 z-[200] space-y-2"></div>
</Layout>

<script>
const BASE_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:8787';
const API_URL = `${BASE_URL}/todos`;
let todos = [];
let categories = [];
let totalTodos = 0;
let isAdding = false;
let newTodoInput = null;
let selectedCategoryFilter = null; // null = all, -1 = uncategorized, number = category id

// ==================== THEME + NO-HOVER ====================
function initThemeToggle() {
const toggle = document.getElementById('theme-toggle');
if (!toggle) return;
const html = document.documentElement;
const savedTheme = localStorage.getItem('theme');
const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
if (savedTheme === 'dark' || (!savedTheme && prefersDark)) html.classList.add('dark');
toggle.addEventListener('click', () => {
html.classList.toggle('dark');
localStorage.setItem('theme', html.classList.contains('dark') ? 'dark' : 'light');
  });
}

const style = document.createElement('style');
style.textContent = `
  @media (pointer: coarse) { .todo-item button, .glass-card button { transition: none !important; } }
  .todo-item { touch-action: manipulation; }
  .category-node { transition: all 0.1s ease; }
  .category-node:hover { background: rgba(163, 163, 172, 0.08); }
  .category-node.active { background: #a855f7; color: white; }
`;
document.head.appendChild(style);

// ==================== TOASTS ====================
function showToast(message, type = 'success') {
const container = document.getElementById('toast-container');
if (!container) return;
const toast = document.createElement('div');
toast.className = `glass-card px-6 py-4 rounded-2xl flex items-center gap-3 text-sm max-w-xs shadow-xl border-l-4 ${type === 'success' ? 'border-emerald-500' : 'border-red-500'}`;
toast.innerHTML = `<div class="flex-1">${message}</div><button class="text-zinc-400 active:text-zinc-900 dark:active:text-white px-2">×</button>`;
container.appendChild(toast);
const close = () => { toast.style.transition = 'all 0.3s'; toast.style.opacity = '0'; toast.style.transform = 'translateX(20px)'; setTimeout(() => toast.remove(), 300); };
setTimeout(close, 3200);
toast.querySelector('button').onclick = close;
}

// ==================== PROGRESS ====================
function updateProgress(todosData) {
const total = todosData.length;
const completed = todosData.filter(t => t.completed).length;
const percent = total > 0 ? Math.round((completed / total) * 100) : 0;
const circle = document.getElementById('progress-circle');
const text = document.getElementById('progress-text');
const label = document.getElementById('progress-label');
const circumference = 263.89;
if (circle) circle.style.strokeDashoffset = circumference - (percent / 100 * circumference);
if (text) text.textContent = percent;
if (label) label.textContent = `${completed} of ${total} completed`;
if (circle) circle.setAttribute('stroke', percent === 100 ? '#22c55e' : '#a855f7');
}

// ==================== AUTH ====================
async function authFetch(url, options = {}) {
const token = localStorage.getItem('auth_token');
if (!token) { window.location.href = '/'; throw new Error('No token'); }
const res = await fetch(url, {
...options,
headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}`, ...(options.headers || {}) }
  });
if (res.status === 401 || res.status === 403) {
localStorage.removeItem('auth_token');
window.location.href = '/';
throw new Error('Session expired');
  }
return res;
}

// ==================== LOAD DATA ====================
async function loadTodos() {
try {
const res = await authFetch(API_URL);
todos = await res.json();
renderTodos();
updateProgress(todos);
  } catch (err) {
showToast("Failed to load todos", "error");
console.error(err);
  }
}

async function loadCategories() {
try {
const res = await authFetch(`${BASE_URL}/todos/categories`);
const data = await res.json();
categories = data.success ? data.data : [];
renderCategoryTree();
renderCategoryManagementTree();
  } catch (err) {
console.error("Failed to load categories", err);
  }
}

// ==================== CATEGORY TREE RENDER (Sidebar) ====================
function renderCategoryTree() {
const container = document.getElementById('category-tree');
if (!container) return;
container.innerHTML = '';

const allBtn = document.createElement('div');
allBtn.className = `category-node flex items-center gap-2 px-3 py-2 rounded-xl cursor-pointer text-sm ${selectedCategoryFilter === null ? 'bg-violet-500 text-white' : 'hover:bg-zinc-100 dark:hover:bg-white/5'}`;
allBtn.innerHTML = `<span>📋</span> <span>All Tasks</span>`;
allBtn.onclick = () => { selectedCategoryFilter = null; renderTodos(); renderCategoryTree(); };
container.appendChild(allBtn);

function renderNode(cat, level = 0) {
const div = document.createElement('div');
div.className = `category-node flex items-center gap-2 px-3 py-2 rounded-xl cursor-pointer text-sm ml-${level * 4} ${selectedCategoryFilter === cat.id ? 'bg-violet-500 text-white' : 'hover:bg-zinc-100 dark:hover:bg-white/5'}`;
div.innerHTML = `
<span>${level === 0 ? '📁' : '↳'}</span>
<span class="flex-1 truncate">${cat.name}</span>
<span class="text-[10px] opacity-60">${cat.children?.length || 0}</span>
`;
div.onclick = (e) => {
e.stopImmediatePropagation();
selectedCategoryFilter = cat.id;
renderTodos();
renderCategoryTree();
};
container.appendChild(div);

if (cat.children && cat.children.length > 0) {
cat.children.forEach(child => renderNode(child, level + 1));
}
}

categories.forEach(cat => renderNode(cat));
}

// ==================== CATEGORY MANAGEMENT MODAL ====================
function openCategoryModal() {
const modal = document.getElementById('category-modal');
if (modal) modal.style.display = 'flex';
renderCategoryManagementTree();
}

function renderCategoryManagementTree() {
const container = document.getElementById('category-management-tree');
if (!container) return;
container.innerHTML = '';

function renderNode(cat, level = 0) {
const div = document.createElement('div');
div.className = `flex items-center gap-2 py-2 px-3 rounded-2xl hover:bg-zinc-100 dark:hover:bg-white/5 ml-${level * 3}`;
div.innerHTML = `
<div class="flex-1 flex items-center gap-2">
<span>${level === 0 ? '📁' : '↳'}</span>
<span class="font-medium">${cat.name}</span>
</div>
<div class="flex gap-1">
<button class="add-sub px-2 py-1 text-xs rounded-lg bg-zinc-100 dark:bg-white/10 active:bg-zinc-200">+ Sub</button>
<button class="edit-cat px-2 py-1 text-xs rounded-lg bg-zinc-100 dark:bg-white/10 active:bg-zinc-200">✏️</button>
<button class="delete-cat px-2 py-1 text-xs rounded-lg bg-red-100 dark:bg-red-500/20 text-red-600 active:bg-red-200">🗑️</button>
</div>
`;

div.querySelector('.add-sub').onclick = async () => {
const name = prompt(`Sub-category name under "${cat.name}"`);
if (name) {
await createCategory(name, cat.id);
renderCategoryManagementTree();
renderCategoryTree();
loadTodos();
}
};

div.querySelector('.edit-cat').onclick = async () => {
const newName = prompt("New name:", cat.name);
if (newName && newName !== cat.name) {
await authFetch(`${BASE_URL}/todos/categories/${cat.id}`, {
method: 'PUT',
body: JSON.stringify({ name: newName })
});
renderCategoryManagementTree();
renderCategoryTree();
loadTodos();
}
};

div.querySelector('.delete-cat').onclick = async () => {
if (confirm(`Delete "${cat.name}"?`)) {
const cascade = confirm("Delete all sub-categories too? (cascade)");
const url = `${BASE_URL}/todos/categories/${cat.id}${cascade ? '?cascade=true' : ''}`;
await authFetch(url, { method: 'DELETE' });
renderCategoryManagementTree();
renderCategoryTree();
loadTodos();
}
};

container.appendChild(div);

if (cat.children && cat.children.length > 0) {
cat.children.forEach(child => renderNode(child, level + 1));
}
}

categories.forEach(cat => renderNode(cat));
}

async function createCategory(name, parentId = null) {
try {
await authFetch(`${BASE_URL}/todos/categories`, {
method: 'POST',
body: JSON.stringify({ name: name.trim(), parent_id: parentId })
});
await loadCategories();
showToast("Category created");
} catch (e) {
showToast("Failed to create category", "error");
}
}

// ==================== RENDER TODOS (with category filter) ====================
function renderTodos(filteredTodos = null) {
const list = document.getElementById('todo-list');
if (!list) return;
list.innerHTML = '';

let displayTodos = filteredTodos || todos;

// Apply category filter
if (selectedCategoryFilter !== null) {
if (selectedCategoryFilter === -1) {
displayTodos = displayTodos.filter(t => !t.category_id);
} else {
displayTodos = displayTodos.filter(t => t.category_id === selectedCategoryFilter);
}
}

totalTodos = displayTodos.length;
const posInput = document.getElementById('todo-position');
const totalSpan = document.getElementById('total-positions');
if (posInput) posInput.value = totalTodos + 1;
if (totalSpan) totalSpan.textContent = `of ${totalTodos + 1} positions`;

if (displayTodos.length === 0) {
list.innerHTML = `<div class="glass-card p-12 text-center"><div class="text-6xl mb-4 opacity-40">📝</div><h3 class="text-xl font-medium mb-2">No tasks here</h3><p class="text-zinc-500 dark:text-zinc-400">Try a different category or add new tasks</p></div>`;
return;
}

displayTodos.forEach(todo => {
const item = document.createElement('div');
item.className = `todo-item glass-card group flex flex-col overflow-hidden transition-all active:scale-[0.995]`;
item.dataset.id = todo.id;

const catName = todo.category_name || 'Uncategorized';
const catBadge = todo.category_id 
? `<span class="px-2 py-0.5 text-[10px] rounded-full bg-violet-100 dark:bg-violet-500/20 text-violet-700 dark:text-violet-400">${catName}</span>`
: `<span class="px-2 py-0.5 text-[10px] rounded-full bg-zinc-100 dark:bg-white/10 text-zinc-500">Uncategorized</span>`;

const totalSteps = todo.steps?.length || 0;

item.innerHTML = `
<div class="flex items-center gap-4 p-5 sm:p-6">
<div class="flex-1 min-w-0">
<div class="flex items-start gap-3">
<span class="todo-title flex-1 text-lg font-medium leading-tight break-words ${todo.completed ? 'line-through text-zinc-400 dark:text-zinc-500' : ''}">${todo.title}</span>
<div class="flex items-center gap-2 flex-shrink-0">
<span class="position-badge px-2.5 py-0.5 text-xs rounded-full bg-zinc-100 dark:bg-white/10 text-zinc-500 dark:text-zinc-400 font-mono">#${todo.position}</span>
${catBadge}
${totalSteps > 0 ? `<div class="flex items-center gap-1 text-xs px-2 py-0.5 rounded-full bg-zinc-100 dark:bg-white/5"><span class="text-zinc-500 dark:text-zinc-400">${totalSteps} steps</span></div>` : ''}
</div>
</div>
</div>
<div class="flex items-center gap-1 opacity-100 transition-opacity">
<button class="edit-btn p-3 text-zinc-400 active:text-zinc-900 dark:active:text-white rounded-2xl active:bg-zinc-100 dark:active:bg-white/10">✏️</button>
<button class="delete-btn p-3 text-zinc-400 active:text-red-500 rounded-2xl active:bg-zinc-100 dark:active:bg-white/10">🗑️</button>
</div>
</div>
<div class="steps-section border-t border-zinc-200 dark:border-white/10 px-5 pb-5">
<div class="flex items-center justify-between py-4 cursor-pointer steps-toggle active:bg-zinc-50 dark:active:bg-white/5 rounded-xl -mx-1 px-1">
<div class="flex items-center gap-2 text-sm text-zinc-500 dark:text-zinc-400">
<span>Steps</span>
<span class="text-xs px-2 py-px rounded bg-zinc-100 dark:bg-white/10">${totalSteps}</span>
</div>
<span class="text-lg transition-transform duration-200">▼</span>
</div>
<div class="steps-list hidden space-y-2 pl-4 border-l-2 border-zinc-200 dark:border-white/10">
${todo.steps?.map(step => `
<div class="step-item flex items-center gap-3 group/step" data-step-id="${step.id}">
<span class="step-text flex-1 text-sm cursor-pointer whitespace-pre-wrap break-words">${step.text}</span>
<div class="flex gap-1 opacity-100 transition-opacity">
<button class="step-up text-xs px-3 py-2 text-zinc-400 active:text-zinc-900 dark:active:text-white active:bg-zinc-100 dark:active:bg-white/10 rounded-xl">↑</button>
<button class="step-down text-xs px-3 py-2 text-zinc-400 active:text-zinc-900 dark:active:text-white active:bg-zinc-100 dark:active:bg-white/10 rounded-xl">↓</button>
<button class="step-delete text-xs px-3 py-2 text-red-500 active:text-red-400 active:bg-zinc-100 dark:active:bg-white/10 rounded-xl">×</button>
</div>
</div>
`).join('')}
</div>
<div class="add-step-row flex gap-2 pt-3">
<textarea class="step-input flex-1 bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-white/10 text-sm px-4 py-3 rounded-2xl focus:outline-none focus:border-violet-500 resize-y min-h-[52px]" placeholder="Add a new step... (multi-line supported)" rows="2"></textarea>
<button class="add-step-btn px-6 text-sm bg-zinc-100 dark:bg-white/10 rounded-2xl active:bg-zinc-200 dark:active:bg-white/20 self-start mt-1">Add</button>
</div>
${totalSteps === 0 ? `
<div class="pt-2">
<button class="add-first-step-btn flex items-center gap-2 text-sm text-violet-600 dark:text-violet-400 active:text-violet-700 transition-colors py-1">
<span class="text-lg">+</span> <span>Add first step</span>
</button>
</div>
` : ''}
</div>
`;

list.appendChild(item);
});

enablePointerSortable(list);

// Event delegation
list.onclick = async (e) => {
const target = e.target;
const todoItem = target.closest('.todo-item');
if (!todoItem) return;
const id = parseInt(todoItem.dataset.id);
const todo = todos.find(t => t.id === id);
if (!todo) return;

if (target.closest('.edit-btn')) showEditMode(todoItem, todo);
if (target.closest('.delete-btn')) await deleteTodo(id);

const stepsToggle = target.closest('.steps-toggle');
if (stepsToggle && !target.closest('.add-step-row') && !target.closest('.add-first-step-btn')) {
const stepsList = todoItem.querySelector('.steps-list');
const arrow = stepsToggle.querySelector('span:last-child');
const isHidden = stepsList.classList.contains('hidden');
stepsList.classList.toggle('hidden', !isHidden);
if (arrow) arrow.style.transform = isHidden ? 'rotate(180deg)' : 'rotate(0deg)';
}

if (target.closest('.add-step-btn')) {
const stepInput = todoItem.querySelector('.step-input');
if (stepInput?.value.trim()) {
await addStep(id, stepInput.value.trim());
stepInput.value = '';
}
}

if (target.closest('.add-first-step-btn')) {
const stepsList = todoItem.querySelector('.steps-list');
const arrow = todoItem.querySelector('.steps-toggle span:last-child');
stepsList?.classList.remove('hidden');
if (arrow) arrow.style.transform = 'rotate(180deg)';
setTimeout(() => todoItem.querySelector('.step-input')?.focus(), 30);
}

const stepItem = target.closest('.step-item');
if (stepItem) {
const stepId = parseInt(stepItem.dataset.stepId);
const step = todo.steps?.find(s => s.id === stepId);
if (!step) return;
if (target.closest('.step-text')) editStepText(id, step, target.closest('.step-text'));
if (target.closest('.step-up')) await moveStep(id, stepId, 'up', todo.steps);
if (target.closest('.step-down')) await moveStep(id, stepId, 'down', todo.steps);
if (target.closest('.step-delete')) await deleteStep(id, stepId);
}
};

list.querySelectorAll('.step-input').forEach(inp => inp.onclick = e => e.stopPropagation());
}

// ==================== STEP ACTIONS ====================
async function addStep(todoId, text) {
try {
await authFetch(`${API_URL}/${todoId}/steps`, { method: 'POST', body: JSON.stringify({ text }) });
await loadTodos();
} catch (err) { showToast("Failed to add step", "error"); }
}

async function updateStep(todoId, stepId, updates) {
try {
await authFetch(`${API_URL}/${todoId}/steps/${stepId}`, { method: 'PUT', body: JSON.stringify(updates) });
await loadTodos();
} catch (err) { showToast("Step update failed", "error"); }
}

async function deleteStep(todoId, stepId) {
if (!confirm("Delete this step?")) return;
try {
await authFetch(`${API_URL}/${todoId}/steps/${stepId}`, { method: 'DELETE' });
await loadTodos();
} catch (err) { showToast("Failed to delete step", "error"); }
}

async function moveStep(todoId, stepId, direction, currentSteps) {
const idx = currentSteps.findIndex(s => s.id === stepId);
if (idx === -1) return;
let newPos = direction === 'up' && idx > 0 ? currentSteps[idx - 1].position : (direction === 'down' && idx < currentSteps.length - 1 ? currentSteps[idx + 1].position : null);
if (newPos) await updateStep(todoId, stepId, { position: newPos });
}

// ==================== INLINE EDIT (TODO + CATEGORY) ====================
function showEditMode(item, todo) {
const header = item.querySelector('.flex');
if (!header) return;
header.style.display = 'none';

const editDiv = document.createElement('div');
editDiv.className = 'p-5 flex flex-col gap-3';

const catOptions = categories.flatMap(cat => {
const opts = [{ id: cat.id, name: cat.name }];
if (cat.children) cat.children.forEach(c => opts.push({ id: c.id, name: `↳ ${c.name}` }));
return opts;
});

editDiv.innerHTML = `
<div class="flex gap-3 items-center">
<input type="number" value="${todo.position}" class="w-16 bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-white/20 rounded-2xl px-3 py-3 text-center text-lg">
<input type="text" value="${todo.title}" class="flex-1 bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-white/20 rounded-2xl px-4 py-3 text-lg">
</div>
<div class="flex gap-3 items-center">
<select class="flex-1 bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-white/20 rounded-2xl px-4 py-3 text-sm">
<option value="">Uncategorized</option>
${catOptions.map(c => `<option value="${c.id}" ${todo.category_id == c.id ? 'selected' : ''}>${c.name}</option>`).join('')}
</select>
<button class="save-btn px-6 py-3 bg-emerald-600 rounded-2xl text-sm font-medium text-white active:scale-[0.985]">Save</button>
<button class="cancel-btn px-5 py-3 text-sm text-zinc-600 dark:text-zinc-400 active:text-zinc-900">Cancel</button>
</div>
`;

const posInp = editDiv.querySelector('input[type="number"]');
const titleInp = editDiv.querySelector('input[type="text"]');
const catSelect = editDiv.querySelector('select');

editDiv.querySelector('.save-btn').onclick = async () => {
const updates = { 
title: titleInp.value.trim(), 
position: parseInt(posInp.value),
category_id: catSelect.value ? parseInt(catSelect.value) : null
};
if (updates.title) await updateTodo(todo.id, updates);
editDiv.remove();
header.style.display = 'flex';
};

editDiv.querySelector('.cancel-btn').onclick = () => { editDiv.remove(); header.style.display = 'flex'; };
item.appendChild(editDiv);
titleInp.focus();
titleInp.select();
}

// ==================== ADD TODO (with category) ====================
async function addTodo() {
if (isAdding || !newTodoInput) return;
const posInput = document.getElementById('todo-position');
const addBtn = document.getElementById('add-btn');
const addBtnText = document.getElementById('add-btn-text');
const title = newTodoInput.value.trim();
if (!title) { showToast("Task title cannot be empty", "error"); return; }

isAdding = true;
addBtn.disabled = true;
if (addBtnText) addBtnText.textContent = "Adding...";
newTodoInput.disabled = true;

try {
const position = parseInt(posInput?.value) || (totalTodos + 1);
const catSelect = document.getElementById('category-select');
const category_id = catSelect ? (catSelect.value ? parseInt(catSelect.value) : null) : null;

await authFetch(API_URL, { 
method: 'POST', 
body: JSON.stringify({ title, position, category_id }) 
});
newTodoInput.value = '';
showToast("Task added successfully");
await loadTodos();
} catch (err) {
showToast("Failed to add task", "error");
console.error(err);
} finally {
isAdding = false;
addBtn.disabled = false;
if (addBtnText) addBtnText.textContent = "Add Task";
newTodoInput.disabled = false;
newTodoInput.focus();
if (posInput) posInput.value = totalTodos + 1;
}
}

// ==================== OTHER ACTIONS ====================
async function updateTodo(id, updates) {
try {
await authFetch(`${API_URL}/${id}`, { method: 'PUT', body: JSON.stringify(updates) });
await loadTodos();
} catch (err) { showToast("Update failed", "error"); }
}

async function deleteTodo(id) {
if (!confirm("Delete this task permanently?")) return;
try {
await authFetch(`${API_URL}/${id}`, { method: 'DELETE' });
showToast("Task deleted");
await loadTodos();
} catch (err) { showToast("Delete failed", "error"); }
}

async function resetTodos() {
if (!confirm("Reset all completion status?")) return;
try {
await authFetch(`${BASE_URL}/todos/reset`, { method: 'PUT' });
showToast("All tasks reset");
await loadTodos();
} catch (err) { showToast("Reset failed", "error"); }
}

async function fetchSummary() {
const modal = document.getElementById('summary-modal');
const loading = document.getElementById('summary-loading');
const textEl = document.getElementById('summary-text');
if (!modal || !loading || !textEl) return;
modal.style.display = 'flex';
loading.style.display = 'flex';
textEl.innerHTML = '';
try {
const res = await authFetch(`${API_URL}/summary`);
const data = await res.json();
textEl.innerHTML = data.success ? `<div class="whitespace-pre-wrap">${data.data}</div>` : `Error: ${data.error}`;
} catch (err) {
textEl.textContent = `Failed: ${err.message}`;
} finally {
loading.style.display = 'none';
}
}

